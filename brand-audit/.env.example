# --- everything below is OPTIONAL. The app runs end-to-end with none of it. ---

# Persistence. Unset -> durable file store under DATA_DIR.
# DATABASE_URL=postgres://user:pass@host:5432/brandaudit

# Where screenshots + the file store live.
# DATA_DIR=./.data

# Screenshot storage driver: local (default) | s3
# STORAGE_DRIVER=local

# Multimodal LLM. Unset -> deterministic-only analysis (no imagery/guide parsing).
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5

# Chromium. Auto-detected from PLAYWRIGHT_BROWSERS_PATH when unset.
# CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# Crawl budget
# MAX_PAGES=4
# PAGE_TIMEOUT_MS=25000
